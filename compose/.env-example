# Copy to .env next to the compose file you use, fill in real values, never commit it.

# Which image tag to run: alpha, testing, stable or latest
VERSION=alpha
TZ=Etc/UTC

# Container user (matches the image's user)
HIVEMIND_USER=hivemind

# Host folders for hivemind configuration and share. The configuration folder is
# mounted into the cli and the satellite. With hivemind-voice-sat 2.2.6a1 or
# later it holds one identity per application (HIVEMIND-CRYPTO-1 §2): the
# satellite's is voice-sat/_identity.json, written by
# 'hivemind-client --app voice-sat set-identity'. A plain _identity.json from
# 'set-identity' still works: that release reads it and logs a warning, and
# older releases (what testing and stable resolve today) read only that file.
# The satellite entrypoint checks which release it has and prints the right form.
HIVEMIND_CONFIG_FOLDER=~/hivemind/config
HIVEMIND_SHARE_FOLDER=~/hivemind/share

# Satellite (docker-compose.satellite.yml): credentials issued by the hub
# (hivemind-core add-client). Required unless an identity was already written into
# HIVEMIND_CONFIG_FOLDER with 'hivemind-client set-identity' (add '--app voice-sat'
# for a satellite that names itself; the satellite log says which).
VOICE_SAT_KEY=changeme
VOICE_SAT_PASSWORD=changeme
VOICE_SAT_HOST=ws://hub.example.org
VOICE_SAT_PORT=5678
HIVEMIND_SITEID=default
OVOS_CONFIG_FOLDER=~/hivemind/mycroft
XDG_RUNTIME_DIR=/run/user/1000

# Chatroom (docker-compose.chatroom.yml)
SAT_KEY=changeme
SAT_PASSWORD=changeme
SAT_HOST=ws://hub.example.org
SAT_PORT=5678

# Matrix bot (docker-compose.matrix-bot.yml)
MATRIX_BOT_NAME=hivemind
MATRIX_TOKEN=changeme
MATRIX_HOST=https://matrix.org
MATRIX_ROOM="#myroom:matrix.org"

# Optional memory ceilings per service class
STANDARD_MEMORY_LIMIT=1G
LIGHT_MEMORY_LIMIT=512M
