# HiveMind self-host stack — copy this file to .env and edit.
#
# Nothing in this file is a secret. HiveMind client credentials (access
# keys / passwords for each bridge) are generated automatically on first
# boot by the bootstrap container and stored in the `hivemind-creds` Docker
# volume — they are NEVER written here and NEVER committed to git.
#
# Only fill in the tokens below for the bridges you actually enable with
# `--profile`. Bridges that talk to a self-hosted service (matrix,
# mattermost, hackchat, deltachat, baresip, media-player) need none of this
# and work out of the box.

# ---------------------------------------------------------------------------
# Telegram bridge (profile: telegram)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather on Telegram, copy the token it gives you.
TELEGRAM_TOKEN=

# ---------------------------------------------------------------------------
# Twitch bridge (profile: twitch)
# ---------------------------------------------------------------------------
# 1. Log in as the bot account you want to chat from.
# 2. Get an OAuth token at https://twitchapps.com/tmi/ (starts with "oauth:").
# 3. TWITCH_CHANNEL is the channel to join, WITHOUT the leading #.
TWITCH_OAUTH=
TWITCH_CHANNEL=
TWITCH_NICKNAME=hivemind_bot

# ---------------------------------------------------------------------------
# Matrix bridge (profile: matrix)
# ---------------------------------------------------------------------------
# Leave MATRIX_HOMESERVER unset to use the bundled Conduit homeserver
# (service "matrix-conduit" below, self-hosted, no external account needed).
# Set these only to bridge into an EXTERNAL Matrix homeserver instead:
#   MATRIX_HOMESERVER=https://matrix.org
#   MATRIX_TOKEN=<access token of the bot account, from Element -> Settings -> Help & About>
#   MATRIX_ROOM=#your-room:matrix.org
MATRIX_HOMESERVER=
MATRIX_TOKEN=
MATRIX_ROOM=#hivemind:localhost

# ---------------------------------------------------------------------------
# Mattermost bridge (profile: mattermost)
# ---------------------------------------------------------------------------
# The bundled Mattermost + Postgres (services "mattermost" / "mattermost-db")
# self-host with no external account. On first login at http://localhost:8065
# create a team and a bot account for the bridge, then set:
MATTERMOST_URL=127.0.0.1
MATTERMOST_EMAIL=
MATTERMOST_PASSWORD=
MATTERMOST_TAG=@hivemind_bridge_bot

# ---------------------------------------------------------------------------
# DeltaChat bridge (profile: deltachat)
# ---------------------------------------------------------------------------
# DeltaChat needs a real (or throwaway) e-mail account with IMAP/SMTP access
# — there is nothing to self-host here. testrun.org issues free throwaway
# accounts for exactly this purpose: https://testrun.org/
DELTACHAT_EMAIL=
DELTACHAT_EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# HackChat bridge (profile: hackchat)
# ---------------------------------------------------------------------------
# HackChat channels are free and anonymous — just pick a channel + username,
# no account or token needed.
HACKCHAT_CHANNEL=hivemind-selfhost
HACKCHAT_USERNAME=HiveMindBot

# ---------------------------------------------------------------------------
# Baresip / SIP bridge (profile: baresip)
# ---------------------------------------------------------------------------
# Self-hosted (bundled Asterisk, service "asterisk" below). These are the
# SIP credentials the bridge registers with on the bundled server — change
# them from the defaults if you expose SIP beyond localhost.
SIP_USER=assistant
SIP_PASSWORD=assistantpass

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
HIVEMIND_LANG=en-us
TZ=UTC
